          "kara_anger": -2,
          "plot": -1
        },
        "next": "kara_return_01",
        "set_flags": [
          "kara_released_after_fake_seal"
        ]
      },
      "right": {
        "text": "Sahte mühür de onun oyunu olabilir.",
        "effects": {
          "guven": 1,
          "ordu": -1
        },
        "state": {
          "kara_anger": 3,
          "boy_anger": 2
        },
        "next": "kara_return_01",
        "set_flags": [
          "kara_still_suspected_after_fake_seal"
        ]
      },
      "speaker_id": "boru_kagan"
    },
    {
      "id": "poison_strikes_01",
      "year": 684,
      "season": "İlkbahar",
      "text": "Geç kaldık. Kağan kadehten yalnız bir yudum aldı ama zehir güçlüydü. Yaşayabilir; fakat günlerce otağından çıkamayacak. Boylar haberi almadan bir vekil seçilmeli.",
      "left": {
        "text": "Altun Hatun divanı yönetsin.",
        "effects": {
          "kut": 1,
          "guven": 1
        },
        "state": {
          "altun_influence": 3,
          "arslan_support": 2
        },
        "next": "succession_shadow_01",
        "set_flags": [
          "altun_regency_684"
        ]
      },
      "right": {
        "text": "Kara Yabgu düzeni sağlasın.",
        "effects": {
          "ordu": 2,
          "kut": -2
        },
        "state": {
          "kara_power": 4,
          "arslan_support": -2
        },
        "next": "succession_shadow_01",
        "set_flags": [
          "kara_regency_684"
        ]
      },
      "speaker_id": "altun_hatun",
      "presentation": {
        "kicker": "OTAĞIN KAPILARI KAPANDI",
        "title": "KAĞAN ZEHİRLENDİ",
        "text": "Şimdi mesele kimin suçlu olduğu değil; Kağan yaşarken devletin dağılmasını önlemek.",
        "tone": "danger"
      }
    },
    {
      "id": "kara_return_01",
      "year": 684,
      "season": "İlkbahar",
      "text": "Beni hain ilan edenler şimdi sustu. Ama batı boyları öfkeli. Onları ben yatıştırabilirim; karşılığında sözümün ağırlığını tanıyacaksın.",
      "left": {
        "text": "Batıyı yatıştır. Yetkin sınırlı olacak.",
        "effects": {
          "ordu": 1,
          "halk": 1
        },
        "state": {
          "kara_power": 2,
          "kara_anger": -1,
          "boy_anger": -2
        },
        "next": "bayir_uprising_01"
      },
      "right": {
        "text": "Bu fırsatçılık. Yetki yok.",
        "effects": {
          "kut": 1
        },
        "state": {
          "kara_anger": 3,
          "boy_anger": 2
        },
        "next": "bayir_uprising_01"
      },
      "speaker_id": "kara_yabgu"
    },
    {
      "id": "succession_shadow_01",
      "year": 684,
      "season": "İlkbahar",
      "text": "Kağan nefes alıyor ama gölgesi kısaldı. Şimdi herkes Arslan Tegin'in adını fısıldıyor. Taht boşalmadan veraset savaşı başladı.",
      "left": {
        "text": "Arslan Tegin'i açıkça destekle.",
        "effects": {
          "kut": 1,
          "guven": -1
        },
        "state": {
          "arslan_support": 4,
          "kara_anger": 2
        },
        "next": "bayir_uprising_01",
        "set_flags": [
          "arslan_publicly_backed_684"
        ]
      },
      "right": {
        "text": "Kağan yaşarken varis konuşulmaz.",
