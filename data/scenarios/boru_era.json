    {
      "id": "bayir_uprising_01",
      "year": 684,
      "season": "Yaz",
      "text": "Bayır sancakları kalktı. Üç oba vergi memurlarını kovdu. Daha kötüsü, isyancılar 'Kara Yabgu bizi koruyacak' diye bağırıyor.",
      "left": {
        "text": "Alp Şad orduyu toplasın.",
        "effects": {
          "ordu": 2,
          "hazine": -2
        },
        "state": {
          "alp_loyalty": 1
        },
        "next": [
          {
            "when": {
