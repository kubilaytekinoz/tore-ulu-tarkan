      "speaker_id": "boru_kagan",
      "presentation": {
        "kicker": "SARAYDA ŞÜPHE",
        "title": "MÜHÜRLÜ MEKTUP",
        "text": "Bir deri parçası artık söylenti değil. Kara Yabgu'nun mührüyle yazılmış mektup Kağan'ın önüne kondu.",
        "tone": "danger"
      }
    },
    {
      "id": "alp_accused_01",
      "year": 683,
      "season": "Yaz",
      "text": "Mektubu taşıyan ulak yakalandı. İfadesinde Alp Şad'ın adını verdi. Fakat aynı ulak iki farklı kişiye iki farklı hikâye anlatmış.",
      "left": {
        "text": "Alp Şad görevden alınsın.",
        "effects": {
          "ordu": -3,
          "guven": 1
        },
        "state": {
          "alp_loyalty": -4,
          "plot": 2
        },
        "next": "guard_debt_01",
        "set_flags": [
          "alp_removed_683"
        ]
      },
      "right": {
        "text": "Alp yerinde kalsın. Ulağı sorgulayın.",
        "effects": {
          "ordu": 2,
          "guven": -1
        },
        "state": {
          "alp_loyalty": 3,
          "plot": -1
        },
        "next": "guard_debt_01",
