      "speaker_id": "ak_boru",
      "presentation": {
        "kicker": "TOY GECESİ",
        "title": "KADEHTE BİR KOKU",
        "text": "Müzik sürerken otağın içindeki hava değişti. Kağan'ın kadehine kimsenin dokunmaması gerekiyor.",
        "tone": "danger"
