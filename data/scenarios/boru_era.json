          {
            "id": "kara_choice_01"
          }
        ]
      },
      "speaker_id": "alp_shad",
      "presentation": {
        "kicker": "BATIDAN DUMAN YÜKSELİYOR",
        "title": "SANCAKLAR KALKTI",
        "text": "Vergi kavgası artık bir şikâyet değil. Üç oba açıkça merkezin buyruğuna karşı çıktı.",
        "tone": "danger"
      }
    },
    {
      "id": "alp_betrayal_01",
      "year": 684,
      "season": "Yaz",
      "text": "Ordu yürüyüşe hazırlanırken Alp Şad otağına geldi. Kılıcını yere bıraktı: 'Beni aylarca hain sandınız. Şimdi senden emir almam. Arslan Tegin için hareket edeceğim.' Dışarıda onun askerleri bekliyor.",
      "left": {
        "text": "Arslan adına hareket etmesine izin ver.",
        "effects": {
          "ordu": 2,
          "guven": -2
        },
        "state": {
          "arslan_support": 3,
          "plot": 1
        },
        "next": "battle_climax_01"
      },
      "right": {
        "text": "Tutuklayın.",
        "effects": {
          "ordu": -3,
          "kut": -2
        },
        "state": {
          "plot": 3
        },
        "next": "battle_climax_01"
      },
      "speaker_id": "alp_shad",
      "presentation": {
        "kicker": "ORDUDA ÇATLAK",
        "title": "ALP ŞAD EMİR DİNLEMİYOR",
        "text": "Yıllar önce verdiğin kararlar bugün kılıç kuşanan askerlerin hangi tarafta duracağını belirliyor.",
        "tone": "danger"
      }
    },
    {
      "id": "kara_rebellion_01",
      "year": 684,
      "season": "Yaz",
      "text": "Kara Yabgu kendi sancağını açtı. 'Ben isyan etmedim,' diyor, 'merkez çöktü. Boyları ben koruyacağım.' Batının yarısı onun arkasında.",
      "left": {
        "text": "Üzerine yürü.",
        "effects": {
          "ordu": -2,
          "hazine": -2
        },
        "state": {
          "kara_anger": 2,
          "boy_anger": 2
        },
        "next": "battle_climax_01"
      },
      "right": {
        "text": "Toy çağır. Son kez konuşalım.",
        "effects": {
          "kut": -1,
          "halk": 1
        },
        "state": {
          "kara_power": 1,
          "plot": -1
        },
        "next": "battle_climax_01"
      },
      "speaker_id": "kara_yabgu",
      "presentation": {
        "kicker": "BATI KANADI",
        "title": "KARA YABGU SANCAĞINI AÇTI",
        "text": "Artık pazarlık ile isyan arasındaki çizgi kalmadı. Batının yarısı onun sözünü dinliyor.",
        "tone": "danger"
      }
    },
    {
      "id": "kara_choice_01",
      "year": 684,
      "season": "Yaz",
      "text": "Kara Yabgu isyancı obaların önünde tek başına belirdi. 'Beni suçladın, yine de kan dökülmesini istemiyorum. Yetki ver; sancakları indiririm.' Bu teklif gerçek de olabilir, tuzak da.",
      "left": {
        "text": "Yetkiyi ver. İsyanı bitir.",
        "effects": {
          "halk": 2,
          "kut": -2
        },
        "state": {
          "kara_power": 4,
          "kara_anger": -2
        },
        "next": "battle_climax_01"
      },
      "right": {
        "text": "Hayır. Bu devlet pazarlıkla yönetilmez.",
        "effects": {
          "kut": 2,
          "ordu": -1
        },
        "state": {
          "kara_anger": 3,
          "boy_anger": 2
        },
        "next": "battle_climax_01"
      },
      "speaker_id": "kara_yabgu"
    },
    {
      "id": "battle_climax_01",
      "year": 684,
      "season": "Sonbahar",
      "text": "Kağan zırhını giydi. 'Bu düğümü ben çözeceğim. Ordunun başında çıkıyorum.' Zehirden yeni kalktıysa bile kimse onu durduramıyor. Son söz senin.",
      "left": {
        "text": "Kağan önde yürüsün.",
        "effects": {
          "ordu": 2,
          "kut": 2
        },
        "next": [
          {
            "when": {
              "any": [
                {
                  "key": "plot",
