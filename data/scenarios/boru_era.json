    {
      "id": "feast_poison_01",
      "year": 683,
      "season": "Kış",
      "text": "Toy gecesi Kağan'ın kadehinden acı badem kokusu geliyor. Muhafızbaşı bir anlığına gözlerini kaçırdı. Kimse daha içmedi.",
      "left": {
        "text": "Kadehi değiştir. Kimse anlamasın.",
        "effects": {
          "guven": 1
        },
        "state": {
          "plot": -1
        },
        "next": [
