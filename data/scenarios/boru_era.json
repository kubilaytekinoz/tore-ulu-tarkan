    },
    {
      "id": "guard_debt_01",
      "year": 683,
      "season": "Sonbahar",
      "text": "Kağan'ın muhafızbaşısının ağır borcu var. Son haftalarda cebinde yabancı gümüşler görülmüş.",
      "left": {
        "text": "Borcunu kapat; sonra gözümüz onda olsun.",
        "effects": {
          "hazine": -2
        },
        "state": {
          "guard_loyalty": 3,
          "plot": -1
        },
        "next": "feast_poison_01",
        "set_flags": [
          "guard_debt_paid_683"
