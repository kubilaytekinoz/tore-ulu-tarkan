      },
      "speaker_id": "boru_kagan"
    },
    {
      "id": "alp_border_01",
      "year": 682,
      "season": "Sonbahar",
      "text": "Doğuda yabancı atlı izleri bulduk. Yüz süvariyle sınırı geçip kim olduklarını öğrenebilirim. İzin vermezsen yalnızca bekleriz.",
      "left": {
        "text": "Git. Ama savaşı sen başlatma.",
        "effects": {
          "ordu": 2,
          "hazine": -1
        },
        "state": {
          "alp_loyalty": 2
        },
        "next": "altun_divan_01",
        "set_flags": [
          "alp_trusted_682"
        ]
      },
      "right": {
        "text": "Sınırdan ayrılma. Emir bu.",
        "effects": {
          "ordu": 1,
          "guven": 1
        },
        "state": {
          "alp_loyalty": -2,
          "plot": 1
        },
        "next": "altun_divan_01",
        "set_flags": [
          "alp_restrained_682"
        ]
      },
      "speaker_id": "alp_shad"
    },
    {
      "id": "altun_divan_01",
      "year": 682,
      "season": "Kış",
      "text": "Kağan yalnız askerleri dinliyor. Boy beylerini toyda konuştur. Öfkelerini otağın dışında değil, gözümüzün önünde duyalım.",
      "left": {
        "text": "Toy toplansın. Beyler konuşsun.",
        "effects": {
          "kut": 2,
          "halk": 1,
          "guven": -1
        },
        "state": {
          "altun_influence": 2,
          "boy_anger": -1
        },
        "next": "kara_authority_01",
        "set_flags": [
          "boy_beys_heard_682"
        ]
      },
      "right": {
        "text": "Merkez zayıflık gösteremez.",
        "effects": {
          "guven": 1,
          "halk": -1
        },
        "state": {
          "altun_influence": -1,
          "boy_anger": 1
        },
        "next": "kara_authority_01",
        "set_flags": [
          "central_rule_hardened_682"
        ]
      },
      "speaker_id": "altun_hatun"
    },
    {
      "id": "kara_authority_01",
      "year": 682,
      "season": "Kış",
      "text": "Batıdaki boylar beni dinler. Bana daha geniş yetki ver. Vergiyi de askeri de ben toplarım; Kağan'ın yükü hafifler.",
      "left": {
        "text": "Yetki verilsin. Ama hesap vereceksin.",
        "effects": {
          "ordu": 2,
          "hazine": 2,
          "kut": -1
        },
        "state": {
          "kara_power": 3,
          "kara_anger": -1
        },
        "next": "lost_caravan_01",
        "set_flags": [
          "kara_given_authority_682"
        ]
      },
      "right": {
        "text": "Boyların üstünde yalnız Kağan vardır.",
        "effects": {
          "kut": 2,
          "guven": 1
        },
        "state": {
          "kara_power": -1,
          "kara_anger": 3
        },
        "next": "lost_caravan_01",
        "set_flags": [
          "kara_denied_authority_682"
        ]
      },
      "speaker_id": "kara_yabgu"
    },
    {
      "id": "lost_caravan_01",
      "year": 683,
      "season": "İlkbahar",
      "text": "Bayır vergisini taşıyan kervan kayboldu. Yol kenarında Kara Yabgu'nun mührünü taşıyan bir deri parçası bulunmuş.",
      "left": {
        "text": "Kara Yabgu hesap versin.",
        "effects": {
          "guven": 1,
          "kut": -1
        },
        "state": {
          "kara_anger": 2,
          "plot": 1
        },
        "next": "ak_boru_warning_01"
      },
      "right": {
        "text": "Mühür delil değildir. Sessizce araştır.",
        "effects": {
          "hazine": -1,
          "kut": 1
        },
        "state": {
          "plot": -1,
          "kara_anger": -1
        },
        "next": "ak_boru_warning_01"
      },
      "speaker_id": "altun_hatun"
    },
    {
      "id": "ak_boru_warning_01",
      "year": 683,
      "season": "İlkbahar",
      "text": "Bir kurt ulur, herkes ona bakar. İkinci kurt sessizce çadırın arkasından geçer. Bu yıl gördüğün ilk ihanete inanma, Tarkan.",
      "left": {
        "text": "Sözünü aklımda tutacağım.",
        "effects": {
          "kut": 1
        },
        "state": {
          "plot": -1
        },
        "next": "sealed_letter_01"
      },
      "right": {
        "text": "Kehanetle devlet yönetilmez.",
        "effects": {
          "guven": 1
        },
        "state": {
          "plot": 1
        },
        "next": "sealed_letter_01"
      },
      "speaker_id": "ak_boru"
    },
    {
      "id": "sealed_letter_01",
      "year": 683,
      "season": "Yaz",
      "text": "Muhafızlar Kara Yabgu'nun mührüyle yazılmış bir mektup buldu: 'Toy günü batı sancağı kalkacak.' Kağan öfkeyle sana bakıyor.",
      "left": {
        "text": "Kara Yabgu tutuklansın.",
        "effects": {
          "guven": 2,
          "ordu": -1
        },
        "state": {
          "kara_anger": 3,
          "boy_anger": 2,
