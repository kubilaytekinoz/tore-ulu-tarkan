          "kut": 1,
          "hazine": -2
        },
        "state": {
          "boy_anger": -1
        },
        "next": "alp_border_01",
        "set_flags": [
          "bayir_mercy_682"
        ]
      },
      "right": {
        "text": "Vergi töredir. Toplansın.",
        "effects": {
          "hazine": 3,
          "halk": -2
