      "speaker_id": "boru_kagan",
      "presentation": {
        "kicker": "684  •  SONBAHAR",
        "title": "KAĞAN ZIRHINI GİYDİ",
        "text": "Bütün küçük kararlar bu ana bağlandı. Kağan ordunun önünde mi yürüyecek, yoksa merkezde mi kalacak?",
        "tone": "danger"
      }
    },
    {
      "id": "kagan_falls_01",
      "year": 684,
      "season": "Sonbahar",
      "text": "Savaş kazanıldı ama Kağan dönmedi. Bir ok zırhının altından girdi. Ölmeden önce yalnızca 'Töreyi koru' diyebildi. Şimdi bütün gözler Arslan Tegin'e ve sana çevrildi.",
      "left": {
        "text": "YENİDEN BAŞLA"
      },
      "right": {
        "text": "ANA MENÜ"
      },
      "ending": true,
      "ending_title": "SON: KAĞAN DÜŞTÜ — VERASET KRİZİ BAŞLADI",
      "speaker_id": "altun_hatun",
      "presentation": {
        "kicker": "BİR DEVİR KAPANIYOR",
        "title": "BÖRÜ KAĞAN DÜŞTÜ",
        "text": "Savaş kazanıldı. Fakat bozkıra dönen sancakların arasında Kağan'ın atı boş geliyor.",
        "tone": "danger"
      }
    },
    {
      "id": "kagan_survives_final_01",
      "year": 684,
      "season": "Sonbahar",
      "text": "İsyan dağıldı. Kağan sağ döndü. Esirlerin arasında zehirli kadehte kullanılan yabancı gümüşler bulundu. Kara Yabgu suçsuz değildi; ama zehir onun işi de değildi. Sarayda hâlâ biri var.",
      "left": {
        "text": "YENİDEN BAŞLA"
      },
      "right": {
        "text": "ANA MENÜ"
      },
      "ending": true,
      "ending_title": "SON: İSYAN BİTTİ — AMA GERÇEK HAİN BULUNAMADI",
      "speaker_id": "boru_kagan",
      "presentation": {
        "kicker": "DÖNEMİN SONU",
        "title": "KAĞAN GERİ DÖNDÜ",
        "text": "İsyan dağıldı ama saraydaki ihanetin kökü sökülmedi. Zafer, huzur getirmedi.",
        "tone": "neutral"
      }
    },
    {
      "id": "kara_takes_capital_01",
      "year": 684,
      "season": "Sonbahar",
      "text": "Sen orduyu sınırda tutarken Kara Yabgu başkente girdi. Kapılar ona içeriden açıldı. Kağan tahttan inmedi; fakat artık herkes kimin güçlü olduğunu biliyor.",
      "left": {
        "text": "YENİDEN BAŞLA"
      },
      "right": {
        "text": "ANA MENÜ"
      },
      "ending": true,
      "ending_title": "SON: TAHT DURUYOR — İKTİDAR EL DEĞİŞTİRDİ",
      "speaker_id": "kara_yabgu",
      "presentation": {
        "kicker": "DÖNEMİN SONU",
        "title": "TAHT DURUYOR, GÜÇ DEĞİŞTİ",
        "text": "Kağan hâlâ otağında; fakat başkentin kapılarının kime açıldığı herkes tarafından görüldü.",
        "tone": "danger"
      }
    },
    {
      "id": "arslan_rises_01",
      "year": 684,
      "season": "Sonbahar",
      "text": "Kağan otağında kaldı. Boylar Arslan Tegin'in çevresinde toplandı. İlk kez bir savaş olmadan yeni bir güç doğdu. Kağan ya oğlunu kabul edecek ya da kendi hanedanıyla savaşacak.",
      "left": {
        "text": "YENİDEN BAŞLA"
      },
      "right": {
        "text": "ANA MENÜ"
      },
      "ending": true,
      "ending_title": "SON: ARSLAN TEGİN YÜKSELİYOR",
      "speaker_id": "altun_hatun",
      "presentation": {
        "kicker": "YENİ BİR GÖLGE",
        "title": "ARSLAN TEGİN YÜKSELİYOR",
        "text": "Taht boş değil. Yine de boyların bakışı artık yalnız Börü Kağan'a dönmüyor.",
        "tone": "neutral"
      }
    },
    {
      "id": "cold_peace_01",
      "year": 684,
      "season": "Kış",
      "text": "Sancaklar indi, kılıçlar kınına girdi. Ama hiçbir sorun gerçekten çözülmedi. Kara Yabgu susuyor, Alp Şad uzak duruyor, Altun Hatun oğlunu koruyor. Bu barış yalnızca bir sonraki fırtınanın sessizliği.",
      "left": {
        "text": "YENİDEN BAŞLA"
      },
      "right": {
        "text": "ANA MENÜ"
      },
      "ending": true,
      "ending_title": "SON: SOĞUK BARIŞ",
      "speaker_id": "ak_boru",
      "presentation": {
        "kicker": "DÖNEMİN SONU",
        "title": "SOĞUK BARIŞ",
        "text": "Kılıçlar kında. Hiç kimse yenilmedi; hiç kimse de gerçekten barışmadı.",
        "tone": "neutral"
      }
    },
    {
      "id": "crisis_famine_01",
      "year": 684,
      "season": "Kış",
      "speaker_id": "ak_boru",
      "text": "Kıtlık obaları değil, otağı da vurdu. Hastalık ve açlık birkaç beyi aldı; Börü Kağan da gecenin sonunda nefesini verdi. Dağılan boylar birbirini suçluyor. Yeni Kağan kaldırılana kadar obayı yeniden toplamak sana düştü, Ulu Tarkan.",
      "left": {
        "text": "DÖNEM ÖZETİ"
      },
      "right": {
        "text": "ANA MENÜ"
      },
      "ending": true,
      "ending_title": "DÖNEM KIRILDI — KARA KITLIK",
      "presentation": {
        "kicker": "KARA KITLIK",
        "title": "OTAĞIN ATEŞİ SÖNDÜ",
        "text": "Ambarlar boşaldı. Açlık beylerle halk arasındaki farkı sildi. Bir devir kıtlığın içinde kapandı.",
        "tone": "danger"
      }
    },
    {
      "id": "crisis_kut_break_01",
      "year": 684,
      "season": "Sonbahar",
      "speaker_id": "altun_hatun",
      "text": "Beyler Börü Kağan'ın kutunu yitirdiğini ilan etti. Arslan Tegin'in genç savaşçıları otağa girdi. Çıkan boğuşmada Börü Kağan öldü; gece bitmeden Arslan ak keçe üzerinde Kağan kaldırıldı. Seni ise eski düzenle yeni düzen arasındaki tek köprü olarak bıraktılar.",
      "left": {
        "text": "DÖNEM ÖZETİ"
      },
      "right": {
        "text": "ANA MENÜ"
      },
      "ending": true,
      "ending_title": "DÖNEM KIRILDI — ARSLAN KAĞAN TAHTTA",
      "presentation": {
        "kicker": "TÖRE KIRILDI",
        "title": "GENÇ KAĞAN YÜKSELDİ",
        "text": "Kut çöktüğünde beylerin sabrı da çöktü. Sabah olduğunda tahtın sahibi değişmişti.",
        "tone": "danger"
      }
    },
    {
      "id": "crisis_army_break_01",
      "year": 684,
      "season": "Yaz",
      "speaker_id": "kara_yabgu",
      "text": "Ordu dağıldı. Sınır birlikleri emir dinlemezken Kara Yabgu kendi savaşçılarıyla başkente girdi. Börü Kağan otağından çıkarıldı. Kara Yabgu kendisini Kağan ilan etmedi; fakat herkes kimin buyruğunun geçtiğini biliyor.",
      "left": {
        "text": "DÖNEM ÖZETİ"
      },
      "right": {
        "text": "ANA MENÜ"
      },
      "ending": true,
      "ending_title": "DÖNEM KIRILDI — ORDU ÇÖZÜLDÜ",
      "presentation": {
        "kicker": "ORDU ÇÖKTÜ",
        "title": "BAŞKENTİN KAPILARI AÇILDI",
        "text": "Kılıcı olmayan merkezin sözü de kalmadı. Batı sancağı artık otağın gölgesinde.",
        "tone": "danger"
      }
    }
  ]
